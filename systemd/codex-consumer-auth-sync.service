[Unit]
Description=Distribute access-only Codex credentials to consumer users
After=local-fs.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/codex-consumer-auth-sync
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/alberto/.codex-auth-shared
ReadWritePaths=/home/andres/.codex /home/carlos/.codex /run/lock
