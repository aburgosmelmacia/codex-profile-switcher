#!/usr/bin/env bash

set -euo pipefail
shopt -s nullglob extglob

PROGRAM="${0##*/}"
CODEX_BIN="${CODEX_BIN:-codex}"
PI_BIN="${PI_BIN:-pi}"
SHARED_CODEX_HOME="${CODEX_SHARED_HOME:-${CODEX_HOME:-$HOME/.codex}}"
AUTH_FILE="${AUTH_FILE:-$SHARED_CODEX_HOME/auth.json}"
PROFILE_STORE="${CODEX_PROFILE_STORE:-$SHARED_CODEX_HOME/.codex-profile}"
PROFILE_LOCK_FILE="$PROFILE_STORE/accounts.lock"
PROFILE_LOCK_HELD=0
ACCOUNTS_HOME="${CODEX_AUTH_PROFILES_HOME:-$PROFILE_STORE/accounts}"
LIMITS_HOME="${CODEX_PROFILE_LIMITS_HOME:-$PROFILE_STORE/limits}"
DEFAULT_FILE="${CODEX_PROFILE_DEFAULT_FILE:-$PROFILE_STORE/.default-profile}"
CURRENT_FILE="${CODEX_CURRENT_PROFILE_FILE:-$PROFILE_STORE/.current-profile}"
CONFIG_FILE="${CODEX_PROFILE_CONFIG_FILE:-$PROFILE_STORE/config.toml}"
PROBE_ROOT="${CODEX_PROFILE_PROBE_ROOT:-$PROFILE_STORE/probes}"
LEGACY_PROFILE_ROOT="${CODEX_LEGACY_PROFILE_ROOT:-$HOME/.codex-profiles}"
LIVE_PROBE_TIMEOUT_SECONDS="${CODEX_PROFILE_LIVE_PROBE_TIMEOUT_SECONDS:-25}"
DEBUG_MODE="${CODEX_PROFILE_DEBUG:-0}"
PI_AUTH_FILE="${PI_AUTH_FILE:-$HOME/.pi/agent/auth.json}"
PI_PROVIDER="openai-codex"
TOKEN_LIFETIME_DAYS="${TOKEN_LIFETIME_DAYS:-10}"

AUTO_SWITCH_ENABLED_DEFAULT="false"
AUTO_SWITCH_WEEKLY_THRESHOLD_DEFAULT="20"
AUTO_SWITCH_FIVE_HOUR_THRESHOLD_DEFAULT="20"
AUTO_SWITCH_POLICY_DEFAULT="or"
AUTO_SWITCH_FALLBACK_DEFAULT="default_profile"

declare -A PROBE_WEEKLY=()
declare -A PROBE_FIVE=()
declare -A PROBE_DONE=()
declare -A PROBE_OBSERVED=()

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

note() {
  printf '%s\n' "$*"
}

stderr_note() {
  printf '%s\n' "$*" >&2
}

debug_note() {
  [[ "$DEBUG_MODE" == "1" ]] || return 0
  printf '[debug] %s\n' "$*" >&2
}

resolve_existing_path() {
  local target="${1:-}"
  local resolved=""

  [[ -n "$target" ]] || die "Path is required."
  resolved="$(readlink -f "$target" 2>/dev/null || true)"
  [[ -n "$resolved" ]] || die "Unable to resolve path '$target'."
  printf '%s\n' "$resolved"
}

absolute_target_path() {
  local target="${1:-}"
  local dir base

  [[ -n "$target" ]] || die "Path is required."

  if [[ "$target" == /* ]]; then
    printf '%s\n' "$target"
    return 0
  fi

  dir="$(dirname "$target")"
  base="$(basename "$target")"
  dir="$(cd "$dir" 2>/dev/null && pwd -P)" || die "Unable to resolve parent directory for '$target'."
  printf '%s/%s\n' "$dir" "$base"
}

install_wrapper_usage() {
  cat <<EOF
Usage:
  $PROGRAM install-wrapper [--force] [--wrapper-path PATH] [--real-path PATH] [--codex-bin PATH]

Options:
  --force
      Overwrite existing wrapper or codex-real link if they differ.

  --wrapper-path PATH
      Where to install the generated wrapper. Default: $HOME/.local/bin/codex

  --real-path PATH
      Where to expose the real Codex binary. Default: $HOME/.local/bin/codex-real

  --codex-bin PATH
      Explicit path to the real Codex binary. Use this if autodetection fails.
EOF
}

usage() {
  cat <<EOF
$PROGRAM - shared-session profile manager for Codex accounts

Usage:
  $PROGRAM help
  $PROGRAM install-wrapper [--force] [--wrapper-path PATH] [--real-path PATH] [--codex-bin PATH]
  $PROGRAM list
  $PROGRAM limits
  $PROGRAM limits refresh [profile]
  $PROGRAM setup
  $PROGRAM current
  $PROGRAM use <profile>
  $PROGRAM path <profile>
  $PROGRAM save <profile>
  $PROGRAM login <profile>
  $PROGRAM status [profile]
  $PROGRAM config show
  $PROGRAM config set <key> <value>
  $PROGRAM config tui
  $PROGRAM pi save <profile>
  $PROGRAM pi use <profile>
  $PROGRAM pi run [profile] [-- <pi args...>]
  $PROGRAM pi login <profile>
  $PROGRAM pi convert <profile>
  $PROGRAM pi sync <profile>
  $PROGRAM run [profile] [-- <codex args...>]
  $PROGRAM <profile> [-- <codex args...>]

Commands:
  install-wrapper
      Install a safe 'codex' wrapper that routes through '$PROGRAM run' while
      preserving the real Codex binary as 'codex-real'. This avoids recursive
      symlink loops by forcing internal Codex calls to use the preserved binary.

  list
      List saved auth profiles from $ACCOUNTS_HOME.

  limits
      Show the last known weekly and 5-hour limits cached for each saved profile.
      Use 'limits refresh [profile]' to force a live refresh first.

  setup
      Open the interactive setup TUI. Alias for '$PROGRAM config tui'.

  current
      Show the default profile.

  use <profile>
      Activate the profile for Codex and Pi (building the Pi snapshot from the
      Codex auth when missing) and make it the default.

  path <profile>
      Print the saved auth snapshot path for a profile.

  save <profile>
      Save the current live auth.json as the named profile without logging in again.

  login <profile>
      Run 'codex login --device-auth' in the shared CODEX_HOME and save the
      resulting auth.json as the named profile.

  status [profile]
      Show live login status plus the account id of the live Codex and Pi auth,
      the default profile and every saved profile, and warn when the live Pi
      auth does not match the active profile, or when the live Codex and Pi
      auth are on different accounts. If a profile is provided, also report
      whether its saved auth snapshot exists and whether it is active.

  config show
      Show effective auto-switch configuration.

  config set <key> <value>
      Update one config value in $CONFIG_FILE.
      Supported keys:
        auto_switch.enabled
        auto_switch.weekly_threshold_percent
        auto_switch.five_hour_threshold_percent
        auto_switch.policy
        auto_switch.fallback

  config tui
      Open a small whiptail-based TUI to edit auto-switch config and the default
      profile.

  pi save <profile>
      Save the current Pi openai-codex auth block as the named profile.

  pi use <profile>
      Restore the selected Codex profile and Pi openai-codex auth block. A Pi
      snapshot saved from a different account than its Codex snapshot is
      rejected before anything changes ('pi convert' rebuilds it).

  pi run [profile] [-- <pi args...>]
      Restore the selected profile for Codex and Pi, then run Pi.

  pi login <profile>
      Explain the manual Pi OAuth flow, then point to 'pi save'.

  pi convert <profile>
      Rebuild the saved Pi auth snapshot from the saved Codex profile.

  pi sync <profile>
      Rebuild the Pi snapshot from Codex and update live Pi auth when the
      profile is currently active. When the Codex snapshot carries no readable
      JWT expiry, the snapshot is stamped with a computed expiry and may be
      rewritten again on the next sync.

  run [profile] [-- <codex args...>]
      Restore the selected profile's auth.json into the shared CODEX_HOME and
      run Codex there. Sessions, skills, history, and config remain shared.
      Pi auth is not touched: before any Pi session run '$PROGRAM use <profile>'
      (or '$PROGRAM pi run <profile>').
      If no profile is passed and auto-switch is enabled, the tool evaluates the
      current profile's limits and may jump to a better saved profile.

  <profile> [-- <codex args...>]
      Shorthand for '$PROGRAM run <profile> [-- <codex args...>]'.

Examples:
  $PROGRAM install-wrapper
  $PROGRAM install-wrapper --force
  $PROGRAM save melmacia1
  $PROGRAM login melmacia2
  $PROGRAM setup
  $PROGRAM limits
  $PROGRAM limits refresh
  $PROGRAM limits refresh melmacia2
  $PROGRAM config tui
  $PROGRAM config set auto_switch.enabled true
  $PROGRAM config set auto_switch.weekly_threshold_percent 20
  $PROGRAM pi save melmacia1
  $PROGRAM pi run melmacia1
  $PROGRAM run
  $PROGRAM melmacia2 -- resume --last
EOF
}

trim() {
  local s="${1:-}"
  s="${s##+([[:space:]])}"
  s="${s%%+([[:space:]])}"
  printf '%s' "$s"
}

ensure_dirs() {
  mkdir -p "$SHARED_CODEX_HOME" "$PROFILE_STORE" "$ACCOUNTS_HOME" "$LIMITS_HOME" "$PROBE_ROOT"
  chmod 700 "$PROFILE_STORE" 2>/dev/null || true
  chmod 700 "$ACCOUNTS_HOME" 2>/dev/null || true
  chmod 700 "$LIMITS_HOME" 2>/dev/null || true
  chmod 700 "$PROBE_ROOT" 2>/dev/null || true
}

with_profile_lock() {
  if [[ "$PROFILE_LOCK_HELD" == "1" ]]; then
    "$@"
    return
  fi
  ensure_dirs
  (
    flock -x 9 || return 1
    PROFILE_LOCK_HELD=1
    "$@"
  ) 9>"$PROFILE_LOCK_FILE"
}

validate_profile_name() {
  local profile="${1:-}"

  [[ -n "$profile" ]] || die "Profile name is required."

  if [[ ! "$profile" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    die "Invalid profile '$profile'. Use letters, numbers, dots, dashes, or underscores."
  fi
}

validate_percent() {
  local value="${1:-}"

  [[ "$value" =~ ^[0-9]+$ ]] || die "Expected an integer percent, got '$value'."
  (( value >= 0 && value <= 100 )) || die "Percent must be between 0 and 100, got '$value'."
}

validate_policy() {
  local value="${1:-}"

  case "$value" in
    or|and|weekly_only)
      ;;
    *)
      die "Unsupported auto_switch.policy '$value'. Use: or, and, weekly_only."
      ;;
  esac
}

validate_fallback() {
  local value="${1:-}"

  case "$value" in
    default_profile)
      ;;
    *)
      die "Unsupported auto_switch.fallback '$value'. Use: default_profile."
      ;;
  esac
}

account_path() {
  local profile="$1"
  printf '%s/%s.auth.json\n' "$ACCOUNTS_HOME" "$profile"
}

pi_account_path() {
  local profile="$1"
  printf '%s/%s.pi-auth.json\n' "$ACCOUNTS_HOME" "$profile"
}

legacy_auth_path() {
  local profile="$1"
  printf '%s/%s/auth.json\n' "$LEGACY_PROFILE_ROOT" "$profile"
}

limits_cache_path() {
  local profile="$1"
  printf '%s/%s.toml\n' "$LIMITS_HOME" "$profile"
}

set_default_profile() {
  local profile="$1"

  # El redirect manda: sin '|| return 1' el 'chmod || true' final enmascaraba
  # el fallo de escritura y la activación se daba por buena.
  printf '%s\n' "$profile" >"$DEFAULT_FILE" || return 1
  chmod 600 "$DEFAULT_FILE" 2>/dev/null || true
}

get_default_profile() {
  [[ -f "$DEFAULT_FILE" ]] || return 1

  local profile=""
  IFS= read -r profile <"$DEFAULT_FILE" || true
  [[ -n "$profile" ]] || return 1
  validate_profile_name "$profile"
  printf '%s\n' "$profile"
}

set_current_profile() {
  local profile="$1"

  printf '%s\n' "$profile" >"$CURRENT_FILE" || return 1
  chmod 600 "$CURRENT_FILE" 2>/dev/null || true
}

get_recorded_current_profile() {
  [[ -f "$CURRENT_FILE" ]] || return 1

  local profile=""
  IFS= read -r profile <"$CURRENT_FILE" || true
  [[ -n "$profile" ]] || return 1
  validate_profile_name "$profile"
  printf '%s\n' "$profile"
}

copy_file_secure() {
  local source="$1"
  local destination="$2"
  local target tmp_file target_dir

  target="$destination"
  if [[ -L "$destination" ]]; then
    target="$(readlink -f "$destination")" || die "Unable to resolve symlink '$destination'."
  fi

  if [[ "$PROFILE_LOCK_HELD" != "1" ]]; then
    with_profile_lock copy_file_secure "$source" "$destination"
    return
  fi
  target_dir="$(dirname "$target")"
  tmp_file="$(mktemp "$target_dir/.${target##*/}.tmp.XXXXXX")" || return 1
  if cp "$source" "$tmp_file" && chmod 600 "$tmp_file" && mv -f "$tmp_file" "$target"; then
    return 0
  fi
  rm -f "$tmp_file"
  return 1
}

import_legacy_profile_if_needed() {
  local profile="$1"
  local target legacy

  target="$(account_path "$profile")"
  [[ -f "$target" ]] && return 0

  legacy="$(legacy_auth_path "$profile")"
  [[ -f "$legacy" ]] || return 0

  copy_file_secure "$legacy" "$target" || return 1
  note "Imported legacy auth for '$profile' from $legacy."
}

saved_profiles() {
  ensure_dirs

  local file profile
  for file in "$ACCOUNTS_HOME"/*.auth.json; do
    [[ -f "$file" ]] || continue
    profile="${file##*/}"
    profile="${profile%.auth.json}"
    printf '%s\n' "$profile"
  done
}

require_live_auth() {
  [[ -f "$AUTH_FILE" ]] || die "No live auth file found at $AUTH_FILE. Run '$PROGRAM login <profile>' first."
}

require_pi_auth() {
  [[ -f "$PI_AUTH_FILE" ]] || die "No Pi auth file found at $PI_AUTH_FILE. Run Pi login first, then '$PROGRAM pi save <profile>'."
}

save_live_auth_as_profile() {
  local profile="$1" target

  if [[ "$PROFILE_LOCK_HELD" != "1" ]]; then
    with_profile_lock save_live_auth_as_profile "$profile"
    return
  fi
  require_live_auth
  target="$(account_path "$profile")"
  if [[ -f "$target" ]] && ! python3 - "$AUTH_FILE" "$target" <<'PY'
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        live = json.load(f)["tokens"]["account_id"]
    with open(sys.argv[2], encoding="utf-8") as f:
        saved = json.load(f)["tokens"]["account_id"]
except (OSError, ValueError, TypeError, KeyError):
    raise SystemExit(1)
raise SystemExit(0 if live and live == saved else 1)
PY
  then
    die "Profile '$profile' belongs to a different or unreadable account; refusing overwrite. Keep the live account with '$PROGRAM save <other-name>', re-login this profile with '$PROGRAM login $profile', or delete $CURRENT_FILE if that record is stale."
  fi
  copy_file_secure "$AUTH_FILE" "$target"
}

restore_profile_auth() {
  local profile="$1"
  local source

  import_legacy_profile_if_needed "$profile" || return 1
  source="$(account_path "$profile")"
  [[ -f "$source" ]] || die "Unknown profile '$profile'. Run '$PROGRAM login $profile' first."
  copy_file_secure "$source" "$AUTH_FILE"
}

save_pi_auth_as_profile() {
  local profile="$1"
  local target

  require_pi_auth
  target="$(pi_account_path "$profile")"
  python3 - "$PI_AUTH_FILE" "$target" "$PI_PROVIDER" <<'PY'
import json, os, sys, tempfile
source, target, provider = sys.argv[1:]
with open(source, encoding="utf-8") as f:
    data = json.load(f)
block = data.get(provider)
if not isinstance(block, dict):
    raise SystemExit(f"Missing {provider} auth block in {source}")
os.makedirs(os.path.dirname(target), exist_ok=True)
fd, tmp = tempfile.mkstemp(prefix=os.path.basename(target) + ".tmp.", dir=os.path.dirname(target))
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump({provider: block}, f, indent=2, sort_keys=True)
        f.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, target)
except Exception:
    try:
        os.unlink(tmp)
    except FileNotFoundError:
        pass
    raise
PY
}

validate_pi_auth_snapshot() {
  local profile="$1"
  local source

  source="$(pi_account_path "$profile")"
  [[ -f "$source" ]] || die "Unknown Pi auth profile '$profile'. Run '$PROGRAM pi save $profile' first."
  python3 - "$source" "$PI_PROVIDER" <<'PY'
import json, sys
source_path, provider = sys.argv[1:]
with open(source_path, encoding="utf-8") as f:
    saved = json.load(f)
if not isinstance(saved.get(provider), dict):
    raise SystemExit(f"Missing {provider} auth block in {source_path}")
PY
}

restore_pi_auth() {
  local profile="$1"
  local source

  source="$(pi_account_path "$profile")"
  validate_pi_auth_snapshot "$profile"
  mkdir -p "$(dirname "$PI_AUTH_FILE")"
  python3 - "$PI_AUTH_FILE" "$source" "$PI_PROVIDER" <<'PY'
import json, os, sys, tempfile
live_path, source_path, provider = sys.argv[1:]
if os.path.exists(live_path):
    with open(live_path, encoding="utf-8") as f:
        live = json.load(f)
else:
    live = {}
with open(source_path, encoding="utf-8") as f:
    saved = json.load(f)
block = saved.get(provider)
if not isinstance(block, dict):
    raise SystemExit(f"Missing {provider} auth block in {source_path}")
live[provider] = block
os.makedirs(os.path.dirname(live_path), exist_ok=True)
fd, tmp = tempfile.mkstemp(prefix=os.path.basename(live_path) + ".tmp.", dir=os.path.dirname(live_path))
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(live, f, indent=2, sort_keys=True)
        f.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, live_path)
except Exception:
    try:
        os.unlink(tmp)
    except FileNotFoundError:
        pass
    raise
PY
}

save_pi_auth_from_codex_profile() {
  local profile="$1"
  local source target

  source="$(account_path "$profile")"
  target="$(pi_account_path "$profile")"
  [[ -f "$source" ]] || die "Unknown profile '$profile'. Run '$PROGRAM login $profile' first."
  python3 - "$source" "$target" "$PI_PROVIDER" "$TOKEN_LIFETIME_DAYS" <<'PY'
import base64, binascii, datetime as dt, json, os, sys, tempfile
source, target, provider, lifetime_days = sys.argv[1:]
with open(source, encoding="utf-8") as f:
    codex = json.load(f)
tokens = codex.get("tokens") or {}

def jwt_expiry_ms(access_token):
    try:
        payload = access_token.split(".")[1]
        payload += "=" * (-len(payload) % 4)
        claims = json.loads(base64.urlsafe_b64decode(payload))
        return int(claims["exp"]) * 1000
    except (
        AttributeError,
        binascii.Error,
        IndexError,
        KeyError,
        TypeError,
        UnicodeDecodeError,
        ValueError,
        json.JSONDecodeError,
    ):
        return None

try:
    expires = jwt_expiry_ms(tokens.get("access_token"))
    if expires is None:
        expires = int(tokens.get("expires_at") or (dt.datetime.now(dt.timezone.utc).timestamp() + int(lifetime_days) * 86400)) * 1000
except ValueError:
    raise SystemExit("TOKEN_LIFETIME_DAYS must be an integer")
block = {
    "type": "oauth",
    "access": tokens.get("access_token"),
    "refresh": tokens.get("refresh_token"),
    "expires": expires,
    "accountId": tokens.get("account_id"),
}
missing = [k for k, v in block.items() if k != "type" and not v]
if missing:
    raise SystemExit("Missing Codex token fields: " + ", ".join(missing))
os.makedirs(os.path.dirname(target), exist_ok=True)
fd, tmp = tempfile.mkstemp(prefix=os.path.basename(target) + ".tmp.", dir=os.path.dirname(target))
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump({provider: block}, f, indent=2, sort_keys=True)
        f.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, target)
except Exception:
    try:
        os.unlink(tmp)
    except FileNotFoundError:
        pass
    raise
PY
}

pi_snapshot_current() {
  local profile="$1"
  local source saved
  source="$(account_path "$profile")"
  saved="$(pi_account_path "$profile")"
  [[ -f "$source" && -f "$saved" ]] || return 1
  python3 - "$source" "$saved" "$PI_PROVIDER" <<'PY'
import base64, binascii, json, sys
source, saved, provider = sys.argv[1:]
try:
    with open(source, encoding="utf-8") as f:
        tokens = json.load(f)["tokens"]
    with open(saved, encoding="utf-8") as f:
        block = json.load(f)[provider]
    payload = tokens["access_token"].split(".")[1]
    expiry = int(json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))["exp"]) * 1000
    same = (block.get("access") == tokens["access_token"] and
            block.get("refresh") == tokens["refresh_token"] and
            block.get("accountId") == tokens["account_id"] and
            block.get("expires") == expiry)
except (OSError, ValueError, TypeError, KeyError, IndexError, binascii.Error):
    same = False
raise SystemExit(0 if same else 1)
PY
}

# Publica el snapshot Pi del perfil desde su Codex guardado. Ambas operaciones se
# comprueban: 'pi sync' se invoca dentro de listas '&&' (set -e suprimido) y no
# puede anunciar éxito si la escritura del snapshot o su publicación en el auth
# vivo fallaron.
sync_pi_auth_from_codex_profile() {
  local profile="$1"
  local update_live=0

  if pi_snapshot_current "$profile"; then
    return 0
  fi
  if pi_auth_matches_saved_profile "$profile"; then
    update_live=1
  fi
  save_pi_auth_from_codex_profile "$profile" || {
    stderr_note "Could not write the Pi auth snapshot for '$profile'; the live Pi auth was not touched. Re-run '$PROGRAM pi sync $profile'."
    return 1
  }
  if [[ "$update_live" -eq 1 ]]; then
    restore_pi_auth "$profile" || {
      stderr_note "Could not publish the Pi auth snapshot for '$profile' into '$PI_AUTH_FILE'; re-run '$PROGRAM pi sync $profile' before relying on live Pi auth."
      return 1
    }
    note "Updated live Pi auth for active profile '$profile'."
  else
    note "Updated Pi auth snapshot for inactive profile '$profile'."
  fi
}

pi_auth_matches_saved_profile() {
  local profile="$1"
  local saved

  saved="$(pi_account_path "$profile")"
  [[ -f "$PI_AUTH_FILE" && -f "$saved" ]] || return 1
  python3 - "$PI_AUTH_FILE" "$saved" "$PI_PROVIDER" <<'PY'
import json, sys
live_path, saved_path, provider = sys.argv[1:]
with open(live_path, encoding="utf-8") as f:
    live = json.load(f)
with open(saved_path, encoding="utf-8") as f:
    saved = json.load(f)
raise SystemExit(0 if live.get(provider) == saved.get(provider) else 1)
PY
}

# Un snapshot Pi mal etiquetado (otra cuenta que su snapshot Codex) dejaría las dos
# capas desalineadas: se rechaza ANTES de tocar el auth vivo. La identidad debe
# estar presente y legible en AMBOS: un snapshot ilegible o sin cuenta no pasa.
assert_profile_snapshots_agree() {
  local profile="$1"
  local codex_id pi_id

  codex_id="$(codex_account_id "$(account_path "$profile")")" \
    || die "Profile '$profile' has no readable Codex identity (missing, malformed, or empty tokens.account_id). Re-login it with '$PROGRAM login $profile'."
  pi_id="$(pi_account_id "$(pi_account_path "$profile")")" \
    || die "Profile '$profile' has no readable Pi identity (missing or malformed snapshot, or empty openai-codex.accountId). Rebuild it with '$PROGRAM pi convert $profile'."
  if [[ "$codex_id" != "$pi_id" ]]; then
    die "Profile '$profile' is inconsistent: its Codex snapshot is on account $codex_id but its Pi snapshot is on $pi_id. Rebuild the Pi snapshot with '$PROGRAM pi convert $profile', or re-save Pi with '$PROGRAM pi save $profile' while that account is active."
  fi
}

# El auth Pi vivo se fusiona al publicar: con JSON inválido hay que fallar ANTES de
# cambiar Codex, o la activación quedaría a medias.
require_readable_live_pi_auth() {
  [[ -f "$PI_AUTH_FILE" ]] || return 0
  python3 - "$PI_AUTH_FILE" <<'PY' || die "Live Pi auth '$PI_AUTH_FILE' is not valid JSON; refusing to switch Codex and Pi. Repair or move that file aside, then retry."
import json, sys

with open(sys.argv[1], encoding="utf-8") as f:
    json.load(f)
PY
}

snapshot_switch_state() {
  local dir name target

  mkdir -p "$PROFILE_STORE" \
    || die "Unable to prepare '$PROFILE_STORE' for the switch backup; no state was changed."
  dir="$(mktemp -d "$PROFILE_STORE/switch-state.XXXXXX")" \
    || die "Unable to create a switch backup directory in '$PROFILE_STORE'; no state was changed."
  chmod 700 "$dir" 2>/dev/null || true
  for name in codex.auth.json pi.auth.json current default; do
    case "$name" in
      codex.auth.json) target="$AUTH_FILE" ;;
      pi.auth.json) target="$PI_AUTH_FILE" ;;
      current) target="$CURRENT_FILE" ;;
      default) target="$DEFAULT_FILE" ;;
    esac
    # La captura es completa o la activación no empieza: si faltase una copia, la
    # restauración borraría un estado vivo que nunca se llegó a respaldar.
    if [[ -f "$target" ]]; then
      cp -p "$target" "$dir/$name" \
        || { rm -rf "$dir"; die "Could not back up '$target'; no state was changed."; }
    fi
  done
  printf '%s\n' "$dir"
}

restore_switch_state() {
  local dir="$1" name target
  local -a failed=()

  for name in codex.auth.json pi.auth.json current default; do
    case "$name" in
      codex.auth.json) target="$AUTH_FILE" ;;
      pi.auth.json) target="$PI_AUTH_FILE" ;;
      current) target="$CURRENT_FILE" ;;
      default) target="$DEFAULT_FILE" ;;
    esac
    if [[ -f "$dir/$name" ]]; then
      cp -p "$dir/$name" "$target" || failed+=("$target")
    else
      rm -f "$target" || failed+=("$target")
    fi
  done
  if [[ "${#failed[@]}" -gt 0 ]]; then
    stderr_note "Could not restore: ${failed[*]}"
    return 1
  fi
  return 0
}

# Publica el estado del perfil en Codex y Pi (y, si se pide, el perfil por defecto).
# Cada paso se comprueba explícitamente: el llamador puede invocarnos en una
# condición 'if' o lista '&&', donde set -e está suprimido y un fallo interno
# pasaría inadvertido hasta dejar la activación a medias.
publish_profile_state() {
  local target="$1"
  local with_default="${2:-}"

  switch_profile "$target" || return 1
  restore_pi_auth "$target" || return 1
  if [[ "$with_default" == "--with-default" ]]; then
    set_default_profile "$target" || return 1
  fi
}

# Todo se valida antes del primer cambio y, si la publicación falla a mitad, se
# restauran los estados previos (Codex, Pi, perfil actual y por defecto). Si la
# restauración no puede completarse, el respaldo se conserva y se imprime su ruta:
# una copia fallida a medias pudo truncar un estado vivo, y ese respaldo es la vía
# de recuperación.
switch_pi_profile() {
  local target="$1"
  local with_default="${2:-}"
  local state_dir

  validate_pi_auth_snapshot "$target"
  [[ -f "$(account_path "$target")" ]] \
    || die "Unknown profile '$target'. Run '$PROGRAM login $target' first."
  assert_profile_snapshots_agree "$target"
  require_readable_live_pi_auth

  state_dir="$(snapshot_switch_state)" || return 1
  if ! ( publish_profile_state "$target" "$with_default" ); then
    if restore_switch_state "$state_dir"; then
      rm -rf "$state_dir"
      die "Could not activate '$target' for Codex and Pi; the previous auth state was restored."
    fi
    stderr_note "Could not activate '$target' for Codex and Pi; the previous auth state could NOT be fully restored (see the list above); fix those files before retrying (keep this backup until repaired: $state_dir)."
    return 1
  fi
  rm -rf "$state_dir"
}

codex_account_id() {
  local path="$1"

  [[ -f "$path" ]] || return 1
  python3 - "$path" <<'PY'
import json, sys

try:
    with open(sys.argv[1], encoding="utf-8") as f:
        tokens = (json.load(f) or {}).get("tokens") or {}
    account = tokens.get("account_id")
except (OSError, ValueError, TypeError):
    raise SystemExit(1)
if not account:
    raise SystemExit(1)
print(account)
PY
}

pi_account_id() {
  local path="$1"

  [[ -f "$path" ]] || return 1
  python3 - "$path" "$PI_PROVIDER" <<'PY'
import json, sys

try:
    with open(sys.argv[1], encoding="utf-8") as f:
        block = (json.load(f) or {}).get(sys.argv[2]) or {}
    account = block.get("accountId")
except (OSError, ValueError, TypeError):
    raise SystemExit(1)
if not account:
    raise SystemExit(1)
print(account)
PY
}

# 'use' activa el perfil completo: Codex y Pi. Si falta el snapshot de Pi se
# reconstruye desde el auth de Codex para no dejar las dos capas descuadradas.
activate_profile() {
  local profile="$1"

  if [[ "$PROFILE_LOCK_HELD" != "1" ]]; then
    with_profile_lock activate_profile "$profile"
    return
  fi

  import_legacy_profile_if_needed "$profile" \
    || die "Could not import legacy auth for '$profile'."
  [[ -f "$(account_path "$profile")" ]] \
    || die "Unknown profile '$profile'. Run '$PROGRAM login $profile' first."

  if [[ ! -f "$(pi_account_path "$profile")" ]]; then
    save_pi_auth_from_codex_profile "$profile"
    note "Built Pi auth snapshot for '$profile' from its Codex snapshot."
  fi

  # El perfil por defecto entra en la misma transacción: si no se puede escribir,
  # Codex, Pi y el perfil actual también vuelven a su estado previo.
  switch_pi_profile "$profile" --with-default || return 1
  invalidate_managed_daemon || true
  note "Activated '$profile' for Codex and Pi."
}

match_live_profile() {
  [[ -f "$AUTH_FILE" ]] || return 1

  local file profile
  for file in "$ACCOUNTS_HOME"/*.auth.json; do
    [[ -f "$file" ]] || continue
    if cmp -s "$AUTH_FILE" "$file"; then
      profile="${file##*/}"
      profile="${profile%.auth.json}"
      printf '%s\n' "$profile"
      return 0
    fi
  done

  return 1
}

resolve_profile() {
  local requested="${1:-}"

  if [[ -n "$requested" ]]; then
    validate_profile_name "$requested"
    printf '%s\n' "$requested"
    return 0
  fi

  get_default_profile || die "No default profile set. Run '$PROGRAM use <profile>' or pass a profile explicitly."
}

refresh_recorded_profile_snapshot() {
  local live_profile="${1:-}"

  [[ -n "$live_profile" ]] || return 0
  [[ -f "$AUTH_FILE" ]] || return 0
  save_live_auth_as_profile "$live_profile"
}

switch_profile() {
  local target="$1"
  local live_profile=""
  local recorded_profile=""

  # Sin depender de errexit: el llamador puede invocarnos dentro de una condición
  # o de una lista '&&', donde set -e está suprimido. Cada cambio de estado se
  # comprueba y devuelve no-cero, de modo que la transacción restaure lo previo.
  import_legacy_profile_if_needed "$target" || return 1

  live_profile="$(match_live_profile || true)"
  recorded_profile="$(get_recorded_current_profile || true)"

  if [[ "$live_profile" == "$target" ]]; then
    set_current_profile "$target" || return 1
    return 0
  fi

  if [[ -n "$live_profile" ]]; then
    refresh_recorded_profile_snapshot "$live_profile" || return 1
  elif [[ -n "$recorded_profile" ]]; then
    refresh_recorded_profile_snapshot "$recorded_profile" || return 1
  fi

  restore_profile_auth "$target" || return 1
  set_current_profile "$target" || return 1
}

# El daemon gestionado de Codex (app-server) nace con la cuenta del auth vivo y
# sirve TODAS las sesiones con ella: no relee el auth. Sin invalidarlo, tras un
# cambio de perfil la TUI seguiría usando la cuenta anterior (incidente 29-sep:
# auth vivo en secondary y /status con la ventana de shared).
# La fecha del daemon frente al mtime del auth es una HEURÍSTICA de frescura, no
# una identidad de cuenta: solo tiene resolución de segundos y un cambio de TZ o
# una hora DST ambigua puede desviarla. Ante empate o duda se invalida, que es el
# lado seguro. Identidad estricta: pidfd (fija el pid, sin carrera check/señal) +
# startTicks de /proc/<pid>/stat + bootId + cmdline con 'app-server'; si no se
# puede verificar, NO se señaliza.
# Contrato de retorno: 0 = nada que hacer / fresco / invalidado y confirmado;
# 1 = identidad NO verificable (python exit 11: avisa, NO señaliza; los caminos de
# apertura de TUI ABORTAN salvo CODEX_PROFILE_ALLOW_STALE_DAEMON=1, así ninguna
# costura ni variable relaja la guarda en silencio); 2 = obsoleto y detención NO
# confirmada (python exit 12, o 13: señalizado pero /proc ilegible). El python
# exit 10 (el pid vivo resulta ser un proceso ajeno: cmdline sin 'app-server')
# sale por 0 sin señalizar: no hay daemon nuestro que invalidar.
# Las costuras de prueba (CODEX_PROFILE_BOOT_ID_FILE, CODEX_PROFILE_TEST_STAT_
# UNREADABLE_PID) solo pueden hacer la comprobación MÁS conservadora (un boot
# ilegible cae en rc 1, que ya bloquea la apertura): no reducen la protección.
invalidate_managed_daemon() {
  local pid_file="${SHARED_CODEX_HOME}/app-server-daemon/daemon.pid"
  local rc=0

  [[ -f "$pid_file" ]] || return 0

  python3 - "$pid_file" "$AUTH_FILE" <<'PY' || rc=$?
import datetime
import json
import locale
import os
import signal
import sys
import time

pid_file, auth_file = sys.argv[1], sys.argv[2]
try:
    locale.setlocale(locale.LC_TIME, "C")  # processStartTime viene en formato C
except locale.Error:
    pass


def process_state(pid):
    """'gone' (ausencia comprobada), 'zombie', 'alive' o 'unknown'.

    Un zombi cuenta como terminado: su pid sigue en /proc hasta que el padre lo
    recoja, pero ya no sirve nada. Un error de lectura distinto de la ausencia
    (p. ej. EACCES) es estado DESCONOCIDO: no se puede declarar terminado.
    """
    forced = os.environ.get("CODEX_PROFILE_TEST_STAT_UNREADABLE_PID", "")
    if forced.isdigit() and int(forced) == pid:
        return "unknown"  # solo pruebas: fuerza la rama «no confirmado»
    try:
        with open("/proc/%d/stat" % pid, encoding="utf-8") as fh:
            stat = fh.read()
    except FileNotFoundError:
        return "gone"
    except OSError:
        return "unknown"
    return "zombie" if stat.rstrip("\n")[stat.rindex(")") + 1:].split()[0] == "Z" else "alive"


def final_state(pid, seconds):
    """Espera la salida y solo confirma 'gone' con ausencia/zombi comprobados."""
    deadline = time.monotonic() + seconds
    while True:
        state = process_state(pid)
        if state in ("gone", "zombie"):
            return "gone"
        if state == "unknown":
            return "unknown"
        if time.monotonic() >= deadline:
            return "alive"
        time.sleep(0.1)


try:
    with open(pid_file, encoding="utf-8") as fh:
        data = json.load(fh) or {}
    pid = int(data.get("pid") or 0)
except (OSError, ValueError, TypeError):
    raise SystemExit(11)
if pid <= 0:
    raise SystemExit(11)
if not os.path.exists("/proc/%d" % pid):
    raise SystemExit(0)  # el daemon no está: nada que invalidar

# El pidfd va ANTES de verificar: fija el proceso, así el pid no puede reciclarse
# entre la verificación y la señal (nada de kill por número tras comprobar).
try:
    pidfd = os.pidfd_open(pid)
except OSError:
    raise SystemExit(11)

try:
    with open("/proc/%d/stat" % pid, encoding="utf-8") as fh:
        stat = fh.read()
    # El campo 2 (comm) es el único entre paréntesis y puede tener espacios:
    # contamos desde el campo 3, así que el 22 cae en el índice 19.
    ticks = int(stat.rstrip("\n")[stat.rindex(")") + 1:].split()[19])
except (OSError, ValueError, IndexError):
    raise SystemExit(11)

identity = data.get("processIdentity") or {}
try:
    wanted_ticks = int(identity.get("startTicks"))
except (TypeError, ValueError):
    raise SystemExit(11)  # sin startTicks la identidad no es verificable
if wanted_ticks <= 0 or ticks != wanted_ticks:
    raise SystemExit(11)

want_boot = identity.get("bootId")
if want_boot:
    boot_file = os.environ.get("CODEX_PROFILE_BOOT_ID_FILE") or "/proc/sys/kernel/random/boot_id"
    try:
        with open(boot_file, encoding="utf-8") as fh:
            here_boot = fh.read().strip()
    except OSError:
        here_boot = ""
    # Sin poder leer el boot_id del kernel no se puede contrastar el del JSON:
    # identidad no verificable => nada de señales.
    if not here_boot or want_boot != here_boot:
        raise SystemExit(11)

try:
    with open("/proc/%d/cmdline" % pid, "rb") as fh:
        cmdline = fh.read().replace(b"\0", b" ").decode("utf-8", "replace")
except OSError:
    raise SystemExit(11)
if "app-server" not in cmdline:
    # Pid reciclado por un proceso ajeno: no hay daemon nuestro que invalidar y a
    # un desconocido no se le señaliza nunca (10 => rc 0, silencioso).
    raise SystemExit(10)

try:
    born = datetime.datetime.strptime(data.get("processStartTime") or "",
                                      "%a %b %d %H:%M:%S %Y").timestamp()
except (ValueError, TypeError):
    born = None  # identidad ya verificada: frescura DESCONOCIDA => se invalida
try:
    auth_mtime = os.stat(auth_file).st_mtime
except OSError:
    auth_mtime = None  # sin auth legible la frescura es dudosa: se invalida

# Estrictamente posterior al auth => nació con la cuenta actual. El empate (la
# fecha del daemon solo tiene segundos) es ambiguo y se invalida; sin fecha, la
# frescura es desconocida y también se invalida.
if born is not None and auth_mtime is not None and born > auth_mtime:
    raise SystemExit(0)

try:
    signal.pidfd_send_signal(pidfd, signal.SIGTERM)
except ProcessLookupError:
    raise SystemExit(0)
except OSError:
    raise SystemExit(12)  # no podemos señalizarlo: sigue en pie
if final_state(pid, 2.0) == "gone":
    raise SystemExit(0)

# Escalada por el mismo pidfd: es el mismo proceso que verificamos.
try:
    signal.pidfd_send_signal(pidfd, signal.SIGKILL)
except ProcessLookupError:
    raise SystemExit(0)
except OSError:
    raise SystemExit(12)

state = final_state(pid, 2.0)
if state == "gone":
    raise SystemExit(0)
raise SystemExit(13 if state == "unknown" else 12)
PY

  case "$rc" in
    0) return 0 ;;
    10) return 0 ;;  # el pid vivo es un proceso ajeno: nada que invalidar
    11) stderr_note "warning: could not verify the app-server daemon identity in $pid_file; leaving it untouched"
        return 1 ;;
    12) stderr_note "warning: the app-server daemon is still alive after SIGTERM/SIGKILL; a new TUI may keep using the previous account"
        return 2 ;;
    13) stderr_note "warning: the app-server daemon was signalled but its stop could not be confirmed (unreadable /proc state); a new TUI may keep using the previous account"
        return 2 ;;
    *) stderr_note "warning: could not check the app-server daemon (unexpected exit $rc)"
       return 1 ;;
  esac
}

canonical_path_best_effort() {
  # realpath sin exigir que el fichero exista: sirve para comparar IDENTIDAD de
  # fichero (enlaces y rutas equivalentes incluidos), no la forma textual.
  python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$1" 2>/dev/null || true
}

# El switch y la frescura del daemon se calculan sobre AUTH_FILE, pero Codex se
# lanza con CODEX_HOME=$SHARED_CODEX_HOME y lee $SHARED_CODEX_HOME/auth.json. Si
# AUTH_FILE apunta a OTRO fichero, la comparación puede dar FRESH mientras Codex
# sirve el auth anterior: la garantía de cuenta no se sostiene. Se exige identidad
# de fichero (realpath), no coincidencia textual.
require_effective_auth_file() {
  local declared="${AUTH_FILE:-}"
  local effective="$SHARED_CODEX_HOME/auth.json"
  local declared_real=""
  local effective_real=""

  if [[ "$declared" != "$effective" ]]; then
    declared_real="$(canonical_path_best_effort "$declared")"
    effective_real="$(canonical_path_best_effort "$effective")"
    if [[ -z "$declared_real" || "$declared_real" != "$effective_real" ]]; then
      if [[ "${CODEX_PROFILE_ALLOW_STALE_DAEMON:-}" == "1" ]]; then
        stderr_note "warning: AUTH_FILE ($declared) does not resolve to the auth file Codex reads under CODEX_HOME ($effective); continuing only because CODEX_PROFILE_ALLOW_STALE_DAEMON=1"
        return 0
      fi
      stderr_note "AUTH_FILE ($declared) does not resolve to the auth file Codex reads under CODEX_HOME ($effective): the profile tooling would switch one file while Codex reads another, so the account guarantee cannot be held. Unset AUTH_FILE (or point it at $effective), or set CODEX_PROFILE_ALLOW_STALE_DAEMON=1 to run anyway."
      return 1
    fi
  fi
  return 0
}

load_config() {
  AUTO_SWITCH_ENABLED="$AUTO_SWITCH_ENABLED_DEFAULT"
  AUTO_SWITCH_WEEKLY_THRESHOLD_PERCENT="$AUTO_SWITCH_WEEKLY_THRESHOLD_DEFAULT"
  AUTO_SWITCH_FIVE_HOUR_THRESHOLD_PERCENT="$AUTO_SWITCH_FIVE_HOUR_THRESHOLD_DEFAULT"
  AUTO_SWITCH_POLICY="$AUTO_SWITCH_POLICY_DEFAULT"
  AUTO_SWITCH_FALLBACK="$AUTO_SWITCH_FALLBACK_DEFAULT"

  [[ -f "$CONFIG_FILE" ]] || return 0

  local line in_auto_switch key value
  in_auto_switch=0

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="$(trim "$line")"
    [[ -n "$line" ]] || continue

    if [[ "$line" == "[auto_switch]" ]]; then
      in_auto_switch=1
      continue
    fi

    if [[ "$line" =~ ^\[.*\]$ ]]; then
      in_auto_switch=0
      continue
    fi

    [[ "$in_auto_switch" -eq 1 ]] || continue
    [[ "$line" == *"="* ]] || continue

    key="$(trim "${line%%=*}")"
    value="$(trim "${line#*=}")"

    case "$key" in
      enabled)
        value="${value//\"/}"
        AUTO_SWITCH_ENABLED="$value"
        ;;
      weekly_threshold_percent)
        value="${value//\"/}"
        AUTO_SWITCH_WEEKLY_THRESHOLD_PERCENT="$value"
        ;;
      five_hour_threshold_percent)
        value="${value//\"/}"
        AUTO_SWITCH_FIVE_HOUR_THRESHOLD_PERCENT="$value"
        ;;
      policy)
        value="${value%\"}"
        value="${value#\"}"
        AUTO_SWITCH_POLICY="$value"
        ;;
      fallback)
        value="${value%\"}"
        value="${value#\"}"
        AUTO_SWITCH_FALLBACK="$value"
        ;;
    esac
  done <"$CONFIG_FILE"

  case "$AUTO_SWITCH_ENABLED" in
    true|false)
      ;;
    *)
      AUTO_SWITCH_ENABLED="$AUTO_SWITCH_ENABLED_DEFAULT"
      ;;
  esac

  if ! [[ "$AUTO_SWITCH_WEEKLY_THRESHOLD_PERCENT" =~ ^[0-9]+$ ]]; then
    AUTO_SWITCH_WEEKLY_THRESHOLD_PERCENT="$AUTO_SWITCH_WEEKLY_THRESHOLD_DEFAULT"
  fi

  if ! [[ "$AUTO_SWITCH_FIVE_HOUR_THRESHOLD_PERCENT" =~ ^[0-9]+$ ]]; then
    AUTO_SWITCH_FIVE_HOUR_THRESHOLD_PERCENT="$AUTO_SWITCH_FIVE_HOUR_THRESHOLD_DEFAULT"
  fi

  validate_percent "$AUTO_SWITCH_WEEKLY_THRESHOLD_PERCENT"
  validate_percent "$AUTO_SWITCH_FIVE_HOUR_THRESHOLD_PERCENT"
  validate_policy "$AUTO_SWITCH_POLICY"
  validate_fallback "$AUTO_SWITCH_FALLBACK"
}

write_config() {
  local tmp_file

  validate_percent "$AUTO_SWITCH_WEEKLY_THRESHOLD_PERCENT"
  validate_percent "$AUTO_SWITCH_FIVE_HOUR_THRESHOLD_PERCENT"
  validate_policy "$AUTO_SWITCH_POLICY"
  validate_fallback "$AUTO_SWITCH_FALLBACK"

  ensure_dirs
  tmp_file="$(mktemp "${CONFIG_FILE}.tmp.XXXXXX")"

  {
    printf '[auto_switch]\n'
    printf 'enabled = %s\n' "$AUTO_SWITCH_ENABLED"
    printf 'weekly_threshold_percent = %s\n' "$AUTO_SWITCH_WEEKLY_THRESHOLD_PERCENT"
    printf 'five_hour_threshold_percent = %s\n' "$AUTO_SWITCH_FIVE_HOUR_THRESHOLD_PERCENT"
    printf 'policy = "%s"\n' "$AUTO_SWITCH_POLICY"
    printf 'fallback = "%s"\n' "$AUTO_SWITCH_FALLBACK"
  } >"$tmp_file"

  chmod 600 "$tmp_file" 2>/dev/null || true
  mv "$tmp_file" "$CONFIG_FILE"
}

strip_control_chars() {
  tr -d '\r'
}

write_limits_cache() {
  local profile="$1"
  local weekly="$2"
  local five_hour="$3"
  local observed_at="$4"
  local destination tmp_file

  ensure_dirs
  destination="$(limits_cache_path "$profile")"
  tmp_file="$(mktemp "${destination}.tmp.XXXXXX")"

  {
    printf 'observed_at = "%s"\n' "$observed_at"
    printf 'weekly_remaining_percent = %s\n' "$weekly"
    printf 'five_hour_remaining_percent = %s\n' "$five_hour"
  } >"$tmp_file"

  chmod 600 "$tmp_file" 2>/dev/null || true
  mv "$tmp_file" "$destination"
}

load_limits_cache_into_memory() {
  local profile="$1"
  local cache_file key value line
  local weekly="" five_hour="" observed_at=""

  [[ -n "${PROBE_DONE[$profile]:-}" ]] && return 0
  cache_file="$(limits_cache_path "$profile")"

  if [[ -f "$cache_file" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%%#*}"
      line="$(trim "$line")"
      [[ -n "$line" ]] || continue
      [[ "$line" == *"="* ]] || continue

      key="$(trim "${line%%=*}")"
      value="$(trim "${line#*=}")"

      case "$key" in
        observed_at)
          value="${value%\"}"
          value="${value#\"}"
          observed_at="$value"
          ;;
        weekly_remaining_percent)
          value="${value//\"/}"
          weekly="$value"
          ;;
        five_hour_remaining_percent)
          value="${value//\"/}"
          five_hour="$value"
          ;;
      esac
    done <"$cache_file"
  fi

  if ! [[ "$weekly" =~ ^[0-9]+$ ]]; then
    weekly=""
  fi
  if ! [[ "$five_hour" =~ ^[0-9]+$ ]]; then
    five_hour=""
  fi

  PROBE_WEEKLY["$profile"]="$weekly"
  PROBE_FIVE["$profile"]="$five_hour"
  PROBE_OBSERVED["$profile"]="$observed_at"
  PROBE_DONE["$profile"]=1

  debug_note "limits[$profile] weekly=${weekly:-unknown} five_hour=${five_hour:-unknown} observed_at=${observed_at:-unknown}"
}

latest_rate_limit_record_from_session_file() {
  local session_file="$1"

  jq -r '
    select(.type == "event_msg" and .payload.type == "token_count" and (.payload.rate_limits | type == "object")) |
    .payload.rate_limits as $rl |
    def remaining($minutes):
      if (($rl.primary.window_minutes // -1) == $minutes) then (100 - ($rl.primary.used_percent // 0) | floor | tostring)
      elif (($rl.secondary.window_minutes // -1) == $minutes) then (100 - ($rl.secondary.used_percent // 0) | floor | tostring)
      else "" end;
    [.timestamp, remaining(10080), remaining(300)] | @tsv
  ' "$session_file" 2>/dev/null | tail -n 1
}

update_limits_cache_from_recent_sessions() {
  local profile="$1"
  local started_epoch="$2"
  local shared_home="${3:-$SHARED_CODEX_HOME}"
  local record="" timestamp="" weekly="" five_hour=""
  local best_timestamp="" best_weekly="" best_five=""
  local -a candidate_files=()
  local candidate file_listing=""

  [[ -d "$shared_home/sessions" ]] || return 0

  file_listing="$(find "$shared_home/sessions" -type f -name '*.jsonl' -newermt "@$((started_epoch - 1))" -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -n 12 || true)"
  if [[ -z "$file_listing" ]]; then
    file_listing="$(find "$shared_home/sessions" -type f -name '*.jsonl' -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -n 12 || true)"
  fi

  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    candidate_files+=("${candidate#* }")
  done <<<"$file_listing"

  for candidate in "${candidate_files[@]}"; do
    record="$(latest_rate_limit_record_from_session_file "$candidate" || true)"
    [[ -n "$record" ]] || continue

    timestamp="${record%%$'\t'*}"
    record="${record#*$'\t'}"
    weekly="${record%%$'\t'*}"
    five_hour="${record#*$'\t'}"

    [[ -n "$weekly" || -n "$five_hour" ]] || continue

    if [[ -z "$best_timestamp" || "$timestamp" > "$best_timestamp" || "$timestamp" == "$best_timestamp" ]]; then
      best_timestamp="$timestamp"
      best_weekly="$weekly"
      best_five="$five_hour"
    fi
  done

  if [[ -n "$best_weekly" || -n "$best_five" ]]; then
    [[ -n "$best_weekly" ]] || best_weekly="0"
    [[ -n "$best_five" ]] || best_five="0"
    write_limits_cache "$profile" "$best_weekly" "$best_five" "$best_timestamp"
    PROBE_WEEKLY["$profile"]="$best_weekly"
    PROBE_FIVE["$profile"]="$best_five"
    PROBE_OBSERVED["$profile"]="$best_timestamp"
    PROBE_DONE["$profile"]=1
    stderr_note "Auto-switch: updated cached limits for '$profile' (weekly=${best_weekly}%, five-hour=${best_five}%)."
  fi
}

live_probe_profile_limits() {
  local profile="$1"
  local source probe_home probe_workspace stdout_file stderr_file started_epoch
  local timestamp="" weekly="" five_hour=""

  import_legacy_profile_if_needed "$profile"
  source="$(account_path "$profile")"
  [[ -f "$source" ]] || return 1
  ensure_dirs

  probe_home="$(mktemp -d "$PROBE_ROOT/${profile}.home.XXXXXX")"
  probe_workspace="$(mktemp -d "$PROBE_ROOT/${profile}.work.XXXXXX")"
  stdout_file="$(mktemp "$PROBE_ROOT/${profile}.stdout.XXXXXX")"
  stderr_file="$(mktemp "$PROBE_ROOT/${profile}.stderr.XXXXXX")"

  copy_file_secure "$source" "$probe_home/auth.json"
  if [[ -f "$SHARED_CODEX_HOME/config.toml" ]]; then
    copy_file_secure "$SHARED_CODEX_HOME/config.toml" "$probe_home/config.toml"
  fi

  started_epoch="$(date +%s)"
  timeout "$LIVE_PROBE_TIMEOUT_SECONDS" env CODEX_HOME="$probe_home" "$CODEX_BIN" exec --json \
    --skip-git-repo-check -C "$probe_workspace" "Respond with exactly OK." >"$stdout_file" 2>"$stderr_file" || true

  debug_note "live-probe[$profile] stdout=$(printf '%q' "$(cat "$stdout_file" 2>/dev/null || true)")"
  debug_note "live-probe[$profile] stderr=$(printf '%q' "$(cat "$stderr_file" 2>/dev/null || true)")"

  update_limits_cache_from_recent_sessions "$profile" "$started_epoch" "$probe_home" || true
  timestamp="${PROBE_OBSERVED[$profile]:-}"
  weekly="${PROBE_WEEKLY[$profile]:-}"
  five_hour="${PROBE_FIVE[$profile]:-}"

  if [[ -n "$weekly" || -n "$five_hour" ]]; then
    PROBE_OBSERVED["$profile"]="$timestamp"
    PROBE_WEEKLY["$profile"]="$weekly"
    PROBE_FIVE["$profile"]="$five_hour"
    PROBE_DONE["$profile"]=1
    rm -rf "$probe_home" "$probe_workspace" "$stdout_file" "$stderr_file"
    return 0
  fi

  rm -rf "$probe_home" "$probe_workspace" "$stdout_file" "$stderr_file"
  return 1
}

probe_profile_limits_if_needed() {
  local profile="$1"

  [[ -n "${PROBE_DONE[$profile]:-}" ]] && return 0

  stderr_note "Auto-switch: probing live limits for '$profile'..."
  if live_probe_profile_limits "$profile"; then
    return 0
  fi

  stderr_note "Auto-switch: live probe failed for '$profile'; falling back to cached limits."
  load_limits_cache_into_memory "$profile"
}

metric_score() {
  local metric="${1:-}"

  if [[ "$metric" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$metric"
  else
    printf '%s\n' "-1"
  fi
}

is_below_threshold() {
  local metric="${1:-}"
  local threshold="${2:-}"

  [[ "$metric" =~ ^[0-9]+$ ]] || return 1
  (( metric < threshold ))
}

auto_switch_trigger_reason() {
  local profile="$1"
  local weekly five_hour reasons=()

  probe_profile_limits_if_needed "$profile"
  weekly="${PROBE_WEEKLY[$profile]:-}"
  five_hour="${PROBE_FIVE[$profile]:-}"

  if [[ -z "$weekly" && -z "$five_hour" ]]; then
    printf 'limits unavailable\n'
    return 0
  fi

  case "$AUTO_SWITCH_POLICY" in
    weekly_only)
      if is_below_threshold "$weekly" "$AUTO_SWITCH_WEEKLY_THRESHOLD_PERCENT"; then
        printf 'weekly %s%% < %s%%\n' "$weekly" "$AUTO_SWITCH_WEEKLY_THRESHOLD_PERCENT"
      fi
      ;;
    and)
      if is_below_threshold "$weekly" "$AUTO_SWITCH_WEEKLY_THRESHOLD_PERCENT" && \
         is_below_threshold "$five_hour" "$AUTO_SWITCH_FIVE_HOUR_THRESHOLD_PERCENT"; then
        printf 'weekly %s%% < %s%% and five-hour %s%% < %s%%\n' \
          "$weekly" "$AUTO_SWITCH_WEEKLY_THRESHOLD_PERCENT" \
          "$five_hour" "$AUTO_SWITCH_FIVE_HOUR_THRESHOLD_PERCENT"
      fi
      ;;
    or)
      if is_below_threshold "$weekly" "$AUTO_SWITCH_WEEKLY_THRESHOLD_PERCENT"; then
        reasons+=("weekly ${weekly}% < ${AUTO_SWITCH_WEEKLY_THRESHOLD_PERCENT}%")
      fi
      if is_below_threshold "$five_hour" "$AUTO_SWITCH_FIVE_HOUR_THRESHOLD_PERCENT"; then
        reasons+=("five-hour ${five_hour}% < ${AUTO_SWITCH_FIVE_HOUR_THRESHOLD_PERCENT}%")
      fi
      if [[ "${#reasons[@]}" -gt 0 ]]; then
        printf '%s\n' "$(IFS='; '; printf '%s' "${reasons[*]}")"
      fi
      ;;
  esac
}

choose_best_profile_record() {
  local default_profile="$1"
  shift
  local profiles=("$@")
  local best_profile="" best_weekly_score=-1 best_five_score=-1
  local best_weekly="" best_five=""
  local profile weekly five_hour weekly_score five_score

  for profile in "${profiles[@]}"; do
    probe_profile_limits_if_needed "$profile"
    weekly="${PROBE_WEEKLY[$profile]:-}"
    five_hour="${PROBE_FIVE[$profile]:-}"
    weekly_score="$(metric_score "$weekly")"
    five_score="$(metric_score "$five_hour")"

    if [[ -z "$best_profile" ]] || \
       (( weekly_score > best_weekly_score )) || \
       (( weekly_score == best_weekly_score && five_score > best_five_score )); then
      best_profile="$profile"
      best_weekly_score="$weekly_score"
      best_five_score="$five_score"
      best_weekly="$weekly"
      best_five="$five_hour"
      continue
    fi

    if (( weekly_score == best_weekly_score && five_score == best_five_score )) && \
       [[ "$profile" == "$default_profile" ]]; then
      best_profile="$profile"
      best_weekly_score="$weekly_score"
      best_five_score="$five_score"
      best_weekly="$weekly"
      best_five="$five_hour"
    fi
  done

  printf '%s|%s|%s\n' "$best_profile" "$best_weekly" "$best_five"
}

effective_run_profile() {
  load_config

  local requested="${1:-}"
  local default_profile current_profile trigger_reason chosen_profile chosen_weekly chosen_five chosen_record
  local profiles=()
  local profile

  if [[ -n "$requested" ]]; then
    resolve_profile "$requested"
    return 0
  fi

  default_profile="$(resolve_profile "")"
  if [[ "$AUTO_SWITCH_ENABLED" != "true" ]]; then
    printf '%s\n' "$default_profile"
    return 0
  fi

  while IFS= read -r profile; do
    [[ -n "$profile" ]] || continue
    profiles+=("$profile")
  done < <(saved_profiles)

  if [[ "${#profiles[@]}" -eq 0 ]]; then
    printf '%s\n' "$default_profile"
    return 0
  fi

  if [[ "${#profiles[@]}" -eq 1 ]]; then
    printf '%s\n' "${profiles[0]}"
    return 0
  fi

  current_profile="$(match_live_profile || true)"
  if [[ -n "$current_profile" ]]; then
    probe_profile_limits_if_needed "$current_profile"
    trigger_reason="$(auto_switch_trigger_reason "$current_profile" || true)"
    if [[ -z "$trigger_reason" ]]; then
      stderr_note "Auto-switch: keeping '$current_profile'. Current limits are above threshold."
      printf '%s\n' "$current_profile"
      return 0
    fi
    stderr_note "Auto-switch: evaluating alternatives because '$current_profile' hit trigger: $trigger_reason"
  else
    stderr_note "Auto-switch: no active saved profile detected; selecting the best profile from live limits."
  fi

  chosen_record="$(choose_best_profile_record "$default_profile" "${profiles[@]}")"
  chosen_profile="${chosen_record%%|*}"
  chosen_five="${chosen_record##*|}"
  chosen_weekly="${chosen_record#*|}"
  chosen_weekly="${chosen_weekly%%|*}"
  if [[ -z "$chosen_profile" ]]; then
    stderr_note "Auto-switch: unable to score profiles, falling back to '$default_profile'."
    printf '%s\n' "$default_profile"
    return 0
  fi

  [[ -n "$chosen_weekly" ]] || chosen_weekly="unknown"
  [[ -n "$chosen_five" ]] || chosen_five="unknown"
  stderr_note "Auto-switch: selected '$chosen_profile' (weekly=${chosen_weekly}%, five-hour=${chosen_five}%)."
  printf '%s\n' "$chosen_profile"
}

command_list() {
  ensure_dirs

  local default_profile live_profile profile_path profile_name found=0 tags
  default_profile="$(get_default_profile || true)"
  live_profile="$(match_live_profile || true)"

  for profile_path in "$ACCOUNTS_HOME"/*.auth.json; do
    [[ -f "$profile_path" ]] || continue
    found=1
    profile_name="${profile_path##*/}"
    profile_name="${profile_name%.auth.json}"
    tags=()

    if [[ "$profile_name" == "$live_profile" ]]; then
      tags+=("active")
    fi

    if [[ "$profile_name" == "$default_profile" ]]; then
      tags+=("default")
    fi

    if [[ "${#tags[@]}" -gt 0 ]]; then
      printf '%s (%s)\n' "$profile_name" "$(IFS=', '; printf '%s' "${tags[*]}")"
    else
      printf '%s\n' "$profile_name"
    fi
  done

  if [[ "$found" -eq 0 ]]; then
    note "No saved Codex auth profiles yet."
  fi
}

reset_probe_memory_for_profile() {
  local profile="$1"

  unset 'PROBE_WEEKLY[$profile]'
  unset 'PROBE_FIVE[$profile]'
  unset 'PROBE_DONE[$profile]'
  unset 'PROBE_OBSERVED[$profile]'
}

print_limits_table() {
  ensure_dirs

  local default_profile live_profile found=0
  local profile weekly five_hour observed_at tags status_text weekly_display five_hour_display

  default_profile="$(get_default_profile || true)"
  live_profile="$(match_live_profile || true)"

  printf '%-16s %-8s %-8s %-24s %s\n' "Profile" "Weekly" "5-hour" "Observed" "Status"

  while IFS= read -r profile; do
    [[ -n "$profile" ]] || continue
    found=1

    load_limits_cache_into_memory "$profile"
    weekly="${PROBE_WEEKLY[$profile]:-}"
    five_hour="${PROBE_FIVE[$profile]:-}"
    observed_at="${PROBE_OBSERVED[$profile]:-}"
    tags=()

    if [[ -n "$weekly" ]]; then
      weekly_display="${weekly}%"
    else
      weekly_display="unknown"
    fi
    if [[ -n "$five_hour" ]]; then
      five_hour_display="${five_hour}%"
    else
      five_hour_display="unknown"
    fi
    [[ -n "$observed_at" ]] || observed_at="never"

    if [[ "$profile" == "$live_profile" ]]; then
      tags+=("active")
    fi
    if [[ "$profile" == "$default_profile" ]]; then
      tags+=("default")
    fi

    if [[ "${#tags[@]}" -gt 0 ]]; then
      status_text="$(IFS=', '; printf '%s' "${tags[*]}")"
    else
      status_text="-"
    fi

    printf '%-16s %-8s %-8s %-24s %s\n' \
      "$profile" "$weekly_display" "$five_hour_display" "$observed_at" "$status_text"
  done < <(saved_profiles)

  if [[ "$found" -eq 0 ]]; then
    note "No saved Codex auth profiles yet."
  fi
}

command_limits_refresh() {
  ensure_dirs

  local requested_profile="${1:-}"
  local profiles=()
  local profile refreshed=0

  if [[ -n "$requested_profile" ]]; then
    validate_profile_name "$requested_profile"
    profiles=("$requested_profile")
  else
    while IFS= read -r profile; do
      [[ -n "$profile" ]] || continue
      profiles+=("$profile")
    done < <(saved_profiles)
  fi

  if [[ "${#profiles[@]}" -eq 0 ]]; then
    note "No saved Codex auth profiles yet."
    return 0
  fi

  for profile in "${profiles[@]}"; do
    import_legacy_profile_if_needed "$profile"
    if [[ ! -f "$(account_path "$profile")" ]]; then
      die "Unknown profile '$profile'. Run '$PROGRAM login $profile' first."
    fi

    reset_probe_memory_for_profile "$profile"
    if probe_profile_limits_if_needed "$profile"; then
      refreshed=1
    fi
  done

  if [[ "$refreshed" -eq 0 ]]; then
    stderr_note "No live limits could be refreshed. Showing last known values."
  fi

  print_limits_table
}

command_limits() {
  local subcommand="${1:-show}"
  shift || true

  case "$subcommand" in
    show)
      print_limits_table
      ;;
    refresh)
      command_limits_refresh "$@"
      ;;
    *)
      die "Unknown limits command '$subcommand'. Use: limits, limits refresh [profile]."
      ;;
  esac
}

command_current() {
  local profile

  profile="$(get_default_profile || true)"
  if [[ -n "$profile" ]]; then
    note "$profile"
  else
    note "No default profile set."
  fi
}

command_use() {
  local profile="${1:-}"

  validate_profile_name "$profile"
  ensure_dirs
  activate_profile "$profile"
}

command_path() {
  local profile="${1:-}"

  validate_profile_name "$profile"
  ensure_dirs
  note "$(account_path "$profile")"
}

save_and_record_profile() {
  save_live_auth_as_profile "$1" || return 1
  set_current_profile "$1" || return 1
}

command_save() {
  local profile="${1:-}"

  validate_profile_name "$profile"
  with_profile_lock save_and_record_profile "$profile" || return 1
  note "Saved live auth as '$profile'."
}

login_codex_bin() {
  if [[ -n "${CODEX_LOGIN_BIN:-}" ]]; then
    printf '%s\n' "$CODEX_LOGIN_BIN"
  elif command -v codex-real >/dev/null 2>&1; then
    command -v codex-real
  else
    printf '%s\n' "$CODEX_BIN"
  fi
}

command_login() {
  local profile="${1:-}"
  local login_home login_bin source exit_status

  validate_profile_name "$profile"
  ensure_dirs

  login_home="$(mktemp -d "$PROFILE_STORE/login-$profile.XXXXXX")"
  chmod 700 "$login_home" 2>/dev/null || true
  login_bin="$(login_codex_bin)"

  note "Using isolated CODEX_HOME=$login_home"
  if CODEX_HOME="$login_home" "$login_bin" login --device-auth; then
    source="$login_home/auth.json"
    [[ -f "$source" ]] || { rm -rf "$login_home"; die "Login completed but no auth.json was created in isolated CODEX_HOME."; }
    copy_file_secure "$source" "$(account_path "$profile")"
    rm -rf "$login_home"
    note "Saved login auth as '$profile'. Live auth unchanged. Run '$PROGRAM use $profile' to activate it for Codex and Pi."
  else
    exit_status=$?
    rm -rf "$login_home"
    return "$exit_status"
  fi
}

command_status() {
  local profile="${1:-}"
  local live_profile="" active_profile="" saved_state="missing"
  local default_profile="" codex_live_id="" pi_live_id="" expected_id="" unambiguous=0
  local name codex_id pi_id listed=0

  ensure_dirs

  if [[ -n "$profile" ]]; then
    validate_profile_name "$profile"
    import_legacy_profile_if_needed "$profile" \
      || stderr_note "Note: could not import legacy auth for '$profile'; reporting the saved snapshots as they are."
    [[ -f "$(account_path "$profile")" ]] && saved_state="saved"
  fi

  if ! CODEX_HOME="$SHARED_CODEX_HOME" "$CODEX_BIN" login status; then
    stderr_note "Note: '$CODEX_BIN login status' failed; continuing with the local identity checks."
  fi
  live_profile="$(match_live_profile || true)"
  active_profile="${live_profile:-$(get_recorded_current_profile || true)}"
  default_profile="$(get_default_profile || true)"
  codex_live_id="$(codex_account_id "$AUTH_FILE" || true)"
  pi_live_id="$(pi_account_id "$PI_AUTH_FILE" || true)"

  if [[ -n "$profile" ]]; then
    if [[ "$saved_state" == "missing" ]]; then
      note "Profile '$profile': no saved auth snapshot."
    elif [[ "$live_profile" == "$profile" ]]; then
      note "Profile '$profile': saved and active."
    else
      note "Profile '$profile': saved but not active."
    fi
  elif [[ -n "$live_profile" ]]; then
    note "Active saved profile: $live_profile"
  fi

  note "Profiles: default=${default_profile:-none} live codex=${codex_live_id:-none} live pi=${pi_live_id:-none}"

  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    listed=1
    codex_id="$(codex_account_id "$(account_path "$name")" || true)"
    pi_id="$(pi_account_id "$(pi_account_path "$name")" || true)"
    note "  $name: codex=${codex_id:-none} pi=${pi_id:-none}"
  done < <(saved_profiles)
  [[ "$listed" -eq 1 ]] || note "  (no saved profiles)"

  if [[ -n "$active_profile" ]]; then
    expected_id="$(pi_account_id "$(pi_account_path "$active_profile")" || true)"
    [[ -n "$expected_id" ]] || expected_id="$(codex_account_id "$(account_path "$active_profile")" || true)"
  fi

  if [[ -n "$expected_id" && ( "$expected_id" == "$codex_live_id" || -n "$live_profile" ) ]]; then
    unambiguous=1
  fi

  if [[ -n "$codex_live_id" && -n "$pi_live_id" && "$codex_live_id" != "$pi_live_id" ]]; then
    stderr_note "Warning: live Pi auth ($pi_live_id) does not match live Codex auth ($codex_live_id); they are on different accounts."
    if [[ "$unambiguous" -eq 1 ]]; then
      stderr_note "  Use '${PROGRAM} use ${live_profile:-$active_profile}' to restore Codex and Pi auth together."
    else
      stderr_note "  Find the wanted profile with '${PROGRAM} list', then run '${PROGRAM} use <profile>'."
    fi
  elif [[ -n "$expected_id" && "$pi_live_id" != "$expected_id" ]]; then
    stderr_note "Warning: live Pi auth (${pi_live_id:-none}) does not match active profile '$active_profile' (${expected_id})."
    if [[ "$unambiguous" -eq 1 ]]; then
      stderr_note "  Use '${PROGRAM} use $active_profile' to restore Codex and Pi auth together."
    else
      stderr_note "  Profile '$active_profile' is only recorded, not confirmed; check '${PROGRAM} list' and rerun '${PROGRAM} use <profile>'."
    fi
  fi
}

command_config_show() {
  load_config

  note "Config file: $CONFIG_FILE"
  printf '[auto_switch]\n'
  printf 'enabled = %s\n' "$AUTO_SWITCH_ENABLED"
  printf 'weekly_threshold_percent = %s\n' "$AUTO_SWITCH_WEEKLY_THRESHOLD_PERCENT"
  printf 'five_hour_threshold_percent = %s\n' "$AUTO_SWITCH_FIVE_HOUR_THRESHOLD_PERCENT"
  printf 'policy = "%s"\n' "$AUTO_SWITCH_POLICY"
  printf 'fallback = "%s"\n' "$AUTO_SWITCH_FALLBACK"
}

command_config_set() {
  local key="${1:-}"
  local value="${2:-}"

  [[ -n "$key" ]] || die "Usage: $PROGRAM config set <key> <value>"
  [[ -n "$value" ]] || die "Usage: $PROGRAM config set <key> <value>"

  load_config

  case "$key" in
    auto_switch.enabled)
      case "$value" in
        true|false)
          AUTO_SWITCH_ENABLED="$value"
          ;;
        *)
          die "auto_switch.enabled must be true or false."
          ;;
      esac
      ;;
    auto_switch.weekly_threshold_percent)
      validate_percent "$value"
      AUTO_SWITCH_WEEKLY_THRESHOLD_PERCENT="$value"
      ;;
    auto_switch.five_hour_threshold_percent)
      validate_percent "$value"
      AUTO_SWITCH_FIVE_HOUR_THRESHOLD_PERCENT="$value"
      ;;
    auto_switch.policy)
      validate_policy "$value"
      AUTO_SWITCH_POLICY="$value"
      ;;
    auto_switch.fallback)
      validate_fallback "$value"
      AUTO_SWITCH_FALLBACK="$value"
      ;;
    *)
      die "Unknown config key '$key'."
      ;;
  esac

  write_config
  note "Updated $key."
}

require_whiptail() {
  command -v whiptail >/dev/null 2>&1 || die "whiptail is required for 'config tui'."
}

whiptail_capture() {
  whiptail "$@" 3>&1 1>&2 2>&3
}

config_summary_text() {
  local default_profile=""

  default_profile="$(get_default_profile || true)"
  [[ -n "$default_profile" ]] || default_profile="unset"

  printf 'Config file: %s\n' "$CONFIG_FILE"
  printf 'Auto-switch enabled: %s\n' "$AUTO_SWITCH_ENABLED"
  printf 'Weekly threshold: %s%%\n' "$AUTO_SWITCH_WEEKLY_THRESHOLD_PERCENT"
  printf '5-hour threshold: %s%%\n' "$AUTO_SWITCH_FIVE_HOUR_THRESHOLD_PERCENT"
  printf 'Policy: %s\n' "$AUTO_SWITCH_POLICY"
  printf 'Fallback: %s\n' "$AUTO_SWITCH_FALLBACK"
  printf 'Default profile: %s\n' "$default_profile"
  printf '\n'
  printf 'Auto-switch only affects: codex-profile run\n'
  printf 'Explicit profile runs stay fixed on the chosen profile.\n'
}

list_codex_path_candidates() {
  type -aP codex 2>/dev/null | awk '!seen[$0]++'
}

detect_real_codex_binary() {
  local script_path="$1"
  local wrapper_path="$2"
  local real_path="$3"
  local wrapper_abs real_abs candidate candidate_resolved

  wrapper_abs="$(absolute_target_path "$wrapper_path")"
  real_abs="$(absolute_target_path "$real_path")"

  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    candidate_resolved="$(readlink -f "$candidate" 2>/dev/null || true)"
    [[ -n "$candidate_resolved" ]] || continue

    if [[ "$candidate_resolved" == "$script_path" || "$candidate_resolved" == "$wrapper_abs" || "$candidate_resolved" == "$real_abs" ]]; then
      continue
    fi

    printf '%s\n' "$candidate_resolved"
    return 0
  done < <(list_codex_path_candidates)

  return 1
}

render_wrapper_script() {
  local script_path="$1"
  local real_path="$2"

  cat <<EOF
#!/usr/bin/env bash
set -euo pipefail

# Generated by codex-profile install-wrapper.
exec env CODEX_BIN="$real_path" "$script_path" run -- "\$@"
EOF
}

command_install_wrapper() {
  local force=0
  local wrapper_path="$HOME/.local/bin/codex"
  local real_path="$HOME/.local/bin/codex-real"
  local explicit_codex_bin=""
  local script_path wrapper_dir real_dir real_source existing_real wrapper_content existing_wrapper=""
  local tmp_file

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force)
        force=1
        ;;
      --wrapper-path)
        shift || die "Missing value for --wrapper-path."
        wrapper_path="${1:-}"
        [[ -n "$wrapper_path" ]] || die "Missing value for --wrapper-path."
        ;;
      --real-path)
        shift || die "Missing value for --real-path."
        real_path="${1:-}"
        [[ -n "$real_path" ]] || die "Missing value for --real-path."
        ;;
      --codex-bin)
        shift || die "Missing value for --codex-bin."
        explicit_codex_bin="${1:-}"
        [[ -n "$explicit_codex_bin" ]] || die "Missing value for --codex-bin."
        ;;
      -h|--help)
        install_wrapper_usage
        return 0
        ;;
      *)
        die "Unknown install-wrapper option '$1'."
        ;;
    esac
    shift || true
  done

  wrapper_path="$(absolute_target_path "$wrapper_path")"
  real_path="$(absolute_target_path "$real_path")"
  script_path="$(resolve_existing_path "${BASH_SOURCE[0]}")"

  [[ "$wrapper_path" != "$real_path" ]] || die "Wrapper path and real Codex path must be different."
  [[ "$wrapper_path" != "$script_path" ]] || die "Wrapper path cannot point to this script."
  [[ "$real_path" != "$script_path" ]] || die "Real Codex path cannot point to this script."

  wrapper_dir="$(dirname "$wrapper_path")"
  real_dir="$(dirname "$real_path")"
  mkdir -p "$wrapper_dir" "$real_dir"

  if [[ -n "$explicit_codex_bin" ]]; then
    real_source="$(resolve_existing_path "$explicit_codex_bin")"
  elif [[ -e "$real_path" ]]; then
    real_source="$(resolve_existing_path "$real_path")"
  else
    real_source="$(detect_real_codex_binary "$script_path" "$wrapper_path" "$real_path" || true)"
  fi

  [[ -n "$real_source" ]] || die "Could not detect the real Codex binary. Re-run with --codex-bin PATH."
  [[ -x "$real_source" ]] || die "Resolved Codex binary '$real_source' is not executable."
  [[ "$real_source" != "$script_path" ]] || die "The detected real Codex binary points back to this script."
  [[ "$real_source" != "$wrapper_path" ]] || die "The detected real Codex binary points to the wrapper path."
  [[ "$real_source" != "$real_path" ]] || die "The detected real Codex binary points to the codex-real link path."

  if [[ -e "$real_path" ]]; then
    existing_real="$(resolve_existing_path "$real_path")"
    if [[ "$existing_real" != "$real_source" && "$force" -ne 1 ]]; then
      die "Refusing to overwrite existing '$real_path'. Re-run with --force if you want to replace it."
    fi
  fi

  wrapper_content="$(render_wrapper_script "$script_path" "$real_path")"
  if [[ -e "$wrapper_path" ]]; then
    [[ -f "$wrapper_path" ]] || die "Wrapper path '$wrapper_path' exists but is not a regular file."
    existing_wrapper="$(cat "$wrapper_path")"
    if [[ "$existing_wrapper" != "$wrapper_content" && "$force" -ne 1 ]]; then
      die "Refusing to overwrite existing wrapper '$wrapper_path'. Re-run with --force if you want to replace it."
    fi
  fi

  ln -sfn "$real_source" "$real_path"

  tmp_file="$(mktemp "${wrapper_path}.tmp.XXXXXX")"
  printf '%s\n' "$wrapper_content" >"$tmp_file"
  chmod 755 "$tmp_file"
  mv "$tmp_file" "$wrapper_path"

  note "Installed Codex wrapper at '$wrapper_path'."
  note "Preserved real Codex binary as '$real_path' -> '$real_source'."
  note "The wrapper now launches Codex through '$PROGRAM run' without recursive symlink loops."
}

config_tui_toggle_enabled() {
  local prompt="Auto-switch is currently '$AUTO_SWITCH_ENABLED'. Toggle it?"

  if whiptail --title "codex-profile" --yesno "$prompt" 10 70; then
    if [[ "$AUTO_SWITCH_ENABLED" == "true" ]]; then
      AUTO_SWITCH_ENABLED="false"
    else
      AUTO_SWITCH_ENABLED="true"
    fi
    write_config
  fi
}

config_tui_edit_threshold() {
  local key="$1"
  local label="$2"
  local current_value="$3"
  local input=""

  while true; do
    input="$(whiptail_capture --title "codex-profile" --inputbox "Set $label (0-100)." 10 70 "$current_value")" || return 0
    input="$(trim "$input")"

    if [[ "$input" =~ ^[0-9]+$ ]] && (( input >= 0 && input <= 100 )); then
      break
    fi

    whiptail --title "codex-profile" --msgbox "Enter a whole number between 0 and 100." 8 60
    current_value="$input"
  done

  case "$key" in
    weekly)
      AUTO_SWITCH_WEEKLY_THRESHOLD_PERCENT="$input"
      ;;
    five_hour)
      AUTO_SWITCH_FIVE_HOUR_THRESHOLD_PERCENT="$input"
      ;;
  esac

  write_config
}

config_tui_edit_policy() {
  local choice=""

  choice="$(whiptail_capture --title "codex-profile" --menu "Select auto-switch policy." 14 72 4 \
    "or" "Switch when weekly OR 5-hour falls below threshold." \
    "and" "Switch only when both weekly AND 5-hour fall below threshold." \
    "weekly_only" "Switch based only on the weekly threshold." \
    "cancel" "Return without changing anything.")" || return 0

  [[ "$choice" == "cancel" ]] && return 0
  validate_policy "$choice"
  AUTO_SWITCH_POLICY="$choice"
  write_config
}

config_tui_select_default_profile() {
  local profiles=()
  local profile choice=""

  while IFS= read -r profile; do
    [[ -n "$profile" ]] || continue
    profiles+=("$profile" "$profile")
  done < <(saved_profiles)

  if [[ "${#profiles[@]}" -eq 0 ]]; then
    whiptail --title "codex-profile" --msgbox "No saved profiles are available yet." 8 60
    return 0
  fi

  choice="$(whiptail_capture --title "codex-profile" --menu "Select the default profile." 16 72 8 "${profiles[@]}")" || return 0
  validate_profile_name "$choice"
  set_default_profile "$choice"
}

command_config_tui() {
  local selection=""
  local default_profile=""

  require_whiptail
  ensure_dirs

  while true; do
    load_config
    default_profile="$(get_default_profile || true)"
    [[ -n "$default_profile" ]] || default_profile="unset"

    selection="$(whiptail_capture --title "codex-profile" --menu "Configure codex-profile." 20 78 10 \
      "toggle_auto_switch" "Enabled: $AUTO_SWITCH_ENABLED" \
      "weekly_threshold" "Weekly threshold: ${AUTO_SWITCH_WEEKLY_THRESHOLD_PERCENT}%" \
      "five_hour_threshold" "5-hour threshold: ${AUTO_SWITCH_FIVE_HOUR_THRESHOLD_PERCENT}%" \
      "policy" "Policy: $AUTO_SWITCH_POLICY" \
      "default_profile" "Default profile: $default_profile" \
      "show_config" "Show effective config" \
      "exit" "Exit the TUI")" || break

    case "$selection" in
      toggle_auto_switch)
        config_tui_toggle_enabled
        ;;
      weekly_threshold)
        config_tui_edit_threshold "weekly" "weekly threshold percent" "$AUTO_SWITCH_WEEKLY_THRESHOLD_PERCENT"
        ;;
      five_hour_threshold)
        config_tui_edit_threshold "five_hour" "5-hour threshold percent" "$AUTO_SWITCH_FIVE_HOUR_THRESHOLD_PERCENT"
        ;;
      policy)
        config_tui_edit_policy
        ;;
      default_profile)
        config_tui_select_default_profile
        ;;
      show_config)
        whiptail --title "codex-profile" --msgbox "$(config_summary_text)" 16 78
        ;;
      exit)
        break
        ;;
    esac
  done
}

command_pi() {
  local subcommand="${1:-help}"
  shift || true

  case "$subcommand" in
    save)
      local profile="${1:-}"
      validate_profile_name "$profile"
      ensure_dirs
      with_profile_lock save_pi_auth_as_profile "$profile" || return 1
      note "Saved Pi auth as '$profile'."
      ;;
    use)
      local profile="${1:-}"
      validate_profile_name "$profile"
      ensure_dirs
      with_profile_lock switch_pi_profile "$profile" || return 1
      invalidate_managed_daemon || true
      note "Restored Codex and Pi auth for '$profile'."
      ;;
    run)
      command_pi_run "$@"
      ;;
    login)
      local profile="${1:-}"
      validate_profile_name "$profile"
      note "Pi OAuth is interactive. Run 'pi' and complete login, then run: $PROGRAM pi save $profile"
      ;;
    convert)
      local profile="${1:-}"
      validate_profile_name "$profile"
      ensure_dirs
      with_profile_lock save_pi_auth_from_codex_profile "$profile" || return 1
      note "Converted Codex auth snapshot to Pi auth for '$profile'."
      ;;
    sync)
      local profile="${1:-}"
      validate_profile_name "$profile"
      ensure_dirs
      with_profile_lock sync_pi_auth_from_codex_profile "$profile" || return 1
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      die "Unknown pi command '$subcommand'. Use: save, use, run, login, convert, sync."
      ;;
  esac
}

command_pi_run() {
  local profile="${1:-}"
  local args=()
  local explicit_profile=0
  local selected_profile
  local exit_status=0
  local daemon_rc=0

  if [[ "${1:-}" == "--" ]]; then
    profile=""
  elif [[ -n "${1:-}" ]]; then
    profile="$(resolve_profile "$1")"
    explicit_profile=1
    shift
  else
    profile=""
  fi

  if [[ "${1:-}" == "--" ]]; then
    shift
  fi

  args=("$@")
  ensure_dirs

  if [[ "$explicit_profile" -eq 1 ]]; then
    selected_profile="$profile"
  else
    selected_profile="$(effective_run_profile "")"
  fi

  # H16: un AUTH_FILE desacoplado anula la garantía de cuenta (el switch escribe un
  # fichero y Codex lee otro). Se rechaza antes de tocar nada; el escape explícito
  # permite continuar bajo responsabilidad del operador.
  require_effective_auth_file || return 1

  if ! with_profile_lock switch_pi_profile "$selected_profile"; then
    stderr_note "Could not switch to profile '$selected_profile'; refusing to run $PI_BIN with the previous auth."
    return 1
  fi
  # Todo cambio de auth invalida el daemon; si no se pudo invalidar (rc 1
  # identidad no verificable, rc 2 obsoleto y no detenido) esta TUI podría servir
  # la cuenta anterior, así que no se abre salvo escape explícito.
  invalidate_managed_daemon || daemon_rc=$?
  if [[ "$daemon_rc" -ne 0 && "${CODEX_PROFILE_ALLOW_STALE_DAEMON:-}" != "1" ]]; then
    if [[ "$daemon_rc" -eq 1 ]]; then
      stderr_note "The app-server daemon identity could not be verified; it could still be serving the previous account and would not follow this profile switch; refusing to run $PI_BIN. Set CODEX_PROFILE_ALLOW_STALE_DAEMON=1 to run anyway."
    else
      stderr_note "The stale app-server daemon could not be stopped and would keep serving the previous account; refusing to run $PI_BIN. Set CODEX_PROFILE_ALLOW_STALE_DAEMON=1 to run anyway."
    fi
    return 1
  fi
  "$PI_BIN" "${args[@]}" || exit_status=$?
  return "$exit_status"
}

command_config() {
  local subcommand="${1:-show}"
  shift || true

  case "$subcommand" in
    show)
      command_config_show "$@"
      ;;
    set)
      command_config_set "$@"
      ;;
    tui)
      command_config_tui "$@"
      ;;
    *)
      die "Unknown config command '$subcommand'. Use: show, set, tui."
      ;;
  esac
}

command_setup() {
  command_config_tui "$@"
}

command_run() {
  local profile="${1:-}"
  local args=()
  local explicit_profile=0
  local selected_profile
  local exit_status=0
  local daemon_rc=0
  local auth_writer=0

  if [[ "${1:-}" == "--" ]]; then
    profile=""
  elif [[ -n "${1:-}" ]]; then
    profile="$(resolve_profile "$1")"
    explicit_profile=1
    shift
  else
    profile=""
  fi

  if [[ "${1:-}" == "--" ]]; then
    shift
  fi

  args=("$@")

  ensure_dirs

  if [[ "$explicit_profile" -eq 1 ]]; then
    selected_profile="$profile"
  else
    selected_profile="$(effective_run_profile "")"
  fi

  # H16: un AUTH_FILE desacoplado anula la garantía de cuenta (el switch escribe un
  # fichero y Codex lee otro) y solo se sostiene al abrir una TUI (exec/login/logout
  # son one-shots o escriben el auth: la guarda los cubre en la siguiente apertura).
  if [[ "${args[0]:-}" != "exec" && "${args[0]:-}" != "login" && "${args[0]:-}" != "logout" ]]; then
    require_effective_auth_file || return 1
  fi

  if ! with_profile_lock switch_profile "$selected_profile"; then
    stderr_note "Could not switch to profile '$selected_profile'; refusing to run $CODEX_BIN with the previous auth."
    return 1
  fi
  # Un daemon nacido con el auth anterior seguiría sirviendo esa cuenta: se
  # invalida SIEMPRE tras un cambio de auth, también en los one-shots 'exec' (no
  # usan el daemon, pero lo dejarían obsoleto para cualquier TUI ya abierta).
  invalidate_managed_daemon || daemon_rc=$?
  # 'exec', 'login' y 'logout' no sirven cuota por el daemon: no se bloquean, solo
  # avisa la invalidación; la guarda protege la apertura de una TUI. Bloquea rc 1
  # (identidad no verificable) y rc 2 (obsoleto y no detenido): ninguna costura ni
  # variable relaja la guarda en silencio, solo el escape explícito.
  if [[ "$daemon_rc" -ne 0 && "${args[0]:-}" != "exec" && "${args[0]:-}" != "login" && "${args[0]:-}" != "logout" && "${CODEX_PROFILE_ALLOW_STALE_DAEMON:-}" != "1" ]]; then
    if [[ "$daemon_rc" -eq 1 ]]; then
      stderr_note "The app-server daemon identity could not be verified; it could still be serving the previous account and would not follow this profile switch; refusing to open the TUI. Set CODEX_PROFILE_ALLOW_STALE_DAEMON=1 to run anyway."
    else
      stderr_note "The stale app-server daemon could not be stopped and would keep serving the previous account; refusing to open the TUI. Set CODEX_PROFILE_ALLOW_STALE_DAEMON=1 to run anyway."
    fi
    return 1
  fi
  # 'run -- login' y 'run -- logout' (también el wrapper 'codex login/logout')
  # escriben o borran el auth COMPARTIDO y pueden hacerlo DESPUÉS de la
  # invalidación de arriba. Estos comandos NO usan exec, así que hay post-hook: se
  # invalida otra vez al terminar, o la siguiente TUI seguiría sirviendo la cuenta
  # anterior.
  if [[ "${args[0]:-}" == "login" || "${args[0]:-}" == "logout" ]]; then
    auth_writer=1
  fi
  env CODEX_HOME="$SHARED_CODEX_HOME" "$CODEX_BIN" "${args[@]}" || exit_status=$?
  if [[ "$auth_writer" -eq 1 ]]; then
    daemon_rc=0
    invalidate_managed_daemon || daemon_rc=$?
    if [[ "$daemon_rc" -ne 0 ]]; then
      stderr_note "warning: the app-server daemon could not be stopped after '${args[0]}'; the next TUI may keep using the previous account"
    fi
  fi
  return "$exit_status"
}

main() {
  local command="${1:-help}"
  shift || true

  case "$command" in
    help|-h|--help)
      usage
      ;;
    install-wrapper)
      command_install_wrapper "$@"
      ;;
    list)
      command_list "$@"
      ;;
    limits)
      command_limits "$@"
      ;;
    setup)
      command_setup "$@"
      ;;
    current)
      command_current "$@"
      ;;
    use)
      command_use "$@"
      ;;
    path)
      command_path "$@"
      ;;
    save)
      command_save "$@"
      ;;
    login)
      command_login "$@"
      ;;
    status)
      command_status "$@"
      ;;
    config)
      command_config "$@"
      ;;
    pi)
      command_pi "$@"
      ;;
    run)
      command_run "$@"
      ;;
    *)
      validate_profile_name "$command"
      command_run "$command" "$@"
      ;;
  esac
}

main "$@"
